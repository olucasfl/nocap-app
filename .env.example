# Copie para `.env` (gitignored) e preencha. NUNCA commite o `.env`.

# --- API ---
PORT=3333
# Origem do web em dev (CORS)
WEB_ORIGIN=http://localhost:5173

# --- Banco (Supabase Postgres) ---
# Runtime: transaction pooler (porta 6543), usado com postgres.js e prepare:false
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrations (drizzle-kit): session pooler (porta 5432)
DATABASE_URL_MIGRATIONS=postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3333

# --- Futuro (Etapas 2+), deixe vazio por enquanto ---
# REDIS_URL=
# AUTH_SECRET=
